---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allPosts = (await getCollection('blog')).sort((a, b) => 
  new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime()
);

const categories = [
  '全部',
  '选购与避坑',
  '专线与架构',
  '加密与协议',
  '晚高峰优化',
  'AI与生产力',
  '流媒体与版权',
  '开发出海',
  '游戏与主机',
  '安全与隐私',
  '性价比与财务'
];
---

<BaseLayout
  title="技术博客与选购避坑指南 (205篇) - 节点推荐网权威深度专栏"
  description="汇集节点推荐编辑部的 205 篇深度技术长文。涵盖专线网络拓扑、前沿加密协议、晚高峰抗拥堵实测、ChatGPT/Claude 防封锁、4K 流媒体全解锁及高性价比采购模型。"
  breadcrumbs={[
    { name: '技术博客', url: '/blog/' },
  ]}
>
  <div class="py-6 space-y-8">
    <!-- Header -->
    <header class="border-b border-purple-100 pb-8">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-purple-50 border border-purple-200 text-purple-700 text-xs font-semibold mb-3">
        <span class="w-2 h-2 rounded-full bg-purple-600"></span>
        深度技术实录 · 205 篇原创长文知识库
      </div>
      <h1 class="text-2xl sm:text-4xl font-black text-slate-900 tracking-tight leading-tight">
        技术博客与选购避坑指南专栏
      </h1>
      <p class="text-sm sm:text-base text-slate-600 leading-relaxed mt-4 max-w-3xl">
        从网络协议底层原理解析到商业服务器采购成本核算，我们拒绝虚假跑分水军，为你提供客观、深刻、具备长期指导价值的选型决策模型与技术排障宝典。
      </p>

      <!-- Category Filter Pills -->
      <div class="flex flex-wrap gap-2 mt-6" id="blog-category-tabs">
        {categories.map(c => (
          <button
            type="button"
            data-category-filter={c}
            class={`blog-filter-btn px-3.5 py-1.5 rounded-xl text-xs font-bold transition cursor-pointer ${
              c === '全部'
                ? 'bg-purple-600 text-white shadow-xs'
                : 'bg-white hover:bg-purple-50 text-slate-700 border border-slate-200 hover:border-purple-300'
            }`}
          >
            {c}
          </button>
        ))}
      </div>

      <!-- Quick Search Input -->
      <div class="mt-4 flex flex-col sm:flex-row items-center justify-between gap-3">
        <div class="relative w-full sm:max-w-xl">
          <input
            type="text"
            id="blog-search-input"
            placeholder="🔍 搜索 205 篇技术博客：输入关键词（如 专线、Hysteria2、ChatGPT、Netflix、Docker、跑路、免流等）..."
            class="w-full text-xs sm:text-sm px-4 py-2.5 rounded-xl border border-slate-200 bg-slate-50/50 focus:outline-none focus:border-purple-500 focus:ring-2 focus:ring-purple-200 transition"
          />
        </div>
        <div class="text-xs font-bold text-slate-500 shrink-0" id="blog-counter">
          共收录 <span class="text-purple-700 font-mono font-black">{allPosts.length}</span> 篇深度长文
        </div>
      </div>
    </header>

    <!-- Articles Grid / List -->
    <div class="space-y-6" id="articles-container">
      {allPosts.map((post, idx) => {
        const slug = post.id.replace(/\.(md|mdx)$/, '');
        const category = post.data.category;
        const title = post.data.title;
        const desc = post.data.description;
        const tags = post.data.tags.join(' ');
        return (
          <article
            data-article-card
            data-category={category}
            data-keywords={`${title} ${desc} ${category} ${tags}`.toLowerCase()}
            class="article-item bg-white p-6 sm:p-8 rounded-3xl border border-purple-100/80 shadow-xs hover:border-purple-300 hover:shadow-md transition flex flex-col justify-between"
          >
            <div>
              <div class="flex flex-wrap items-center gap-2 mb-3">
                <span class="px-2.5 py-0.5 rounded-md bg-purple-50 text-purple-700 font-bold text-xs border border-purple-200/60">
                  {category}
                </span>
                <span class="text-xs text-slate-300">·</span>
                <span class="text-xs text-slate-500 font-mono">发布于 {post.data.publishDate}</span>
                {post.data.updatedDate && (
                  <>
                    <span class="text-xs text-slate-300">·</span>
                    <span class="text-xs text-purple-600 font-medium font-mono">更新于 {post.data.updatedDate}</span>
                  </>
                )}
              </div>

              <h2 class="text-lg sm:text-xl font-bold text-slate-900 mb-2 leading-snug">
                <a href={`/blog/${slug}/`} class="hover:text-purple-700 transition">
                  {title}
                </a>
              </h2>

              <p class="text-xs sm:text-sm text-slate-600 leading-relaxed mb-4 line-clamp-2">
                {desc}
              </p>
            </div>

            <div class="flex items-center justify-between pt-4 border-t border-slate-100 text-xs">
              <div class="flex flex-wrap gap-1.5">
                {post.data.tags.slice(0, 3).map(tag => (
                  <span class="px-2 py-0.5 rounded-md bg-slate-100 text-slate-600 text-[11px]">
                    #{tag}
                  </span>
                ))}
              </div>
              <a
                href={`/blog/${slug}/`}
                class="font-bold text-purple-600 hover:text-purple-700 flex items-center gap-1 transition shrink-0 ml-2"
              >
                阅读深度全文 →
              </a>
            </div>
          </article>
        );
      })}
    </div>

    <!-- Empty Search State -->
    <div id="blog-empty-state" class="hidden p-12 text-center bg-white rounded-3xl border border-purple-200/70 shadow-sm">
      <div class="w-12 h-12 mx-auto mb-3 rounded-2xl bg-purple-50 text-purple-600 flex items-center justify-center text-xl font-bold">
        🔍
      </div>
      <h3 class="text-base font-bold text-slate-900">未找到匹配的博客文章</h3>
      <p class="text-slate-500 text-xs mt-1">请尝试更换检索关键词，或点击“全部”分类查看全量文章列表。</p>
    </div>

    <!-- Bottom cross-link cards -->
    <section class="mt-12 bg-gradient-to-r from-purple-50 via-indigo-50 to-purple-50 p-6 sm:p-8 rounded-3xl border border-purple-100 flex flex-col md:flex-row items-center justify-between gap-4">
      <div>
        <h3 class="text-base font-black text-slate-900">深入了解了网络底层原理，想看看实测排行榜？</h3>
        <p class="text-xs text-slate-600 mt-1">
          本站对全网 29 款主流机场建立独立评测与价格核验档案，支持专属立减优惠券：
        </p>
      </div>
      <div class="flex items-center gap-2 shrink-0">
        <a
          href="/ranking/overall/"
          class="px-4 py-2 rounded-xl bg-purple-600 hover:bg-purple-700 text-white font-bold text-xs shadow-sm transition"
        >
          查看综合排行榜
        </a>
        <a
          href="/compare/"
          class="px-4 py-2 rounded-xl bg-white hover:bg-purple-50 text-purple-700 font-semibold text-xs border border-purple-200 transition"
        >
          进入在线对比工具
        </a>
      </div>
    </section>
  </div>
</BaseLayout>

<script is:inline>
  (function() {
    const filterBtns = document.querySelectorAll('.blog-filter-btn');
    const searchInput = document.getElementById('blog-search-input');
    const articles = document.querySelectorAll('[data-article-card]');
    const emptyState = document.getElementById('blog-empty-state');
    const container = document.getElementById('articles-container');
    const counterEl = document.getElementById('blog-counter');

    let currentCategory = '全部';
    let currentQuery = '';

    function filterArticles() {
      let visibleCount = 0;
      articles.forEach(article => {
        const cat = article.getAttribute('data-category') || '';
        const keywords = article.getAttribute('data-keywords') || '';

        const matchCategory = currentCategory === '全部' || cat === currentCategory;
        const matchQuery = !currentQuery || keywords.includes(currentQuery);

        if (matchCategory && matchQuery) {
          article.classList.remove('hidden');
          visibleCount++;
        } else {
          article.classList.add('hidden');
        }
      });

      if (counterEl) {
        counterEl.innerHTML = '已呈现 <span class="text-purple-700 font-mono font-black">' + visibleCount + '</span> 篇长文';
      }

      if (visibleCount === 0) {
        emptyState.classList.remove('hidden');
        container.classList.add('hidden');
      } else {
        emptyState.classList.add('hidden');
        container.classList.remove('hidden');
      }
    }

    filterBtns.forEach(btn => {
      btn.addEventListener('click', function() {
        filterBtns.forEach(b => {
          b.className = 'blog-filter-btn px-3.5 py-1.5 rounded-xl text-xs font-bold transition cursor-pointer bg-white hover:bg-purple-50 text-slate-700 border border-slate-200 hover:border-purple-300';
        });
        this.className = 'blog-filter-btn px-3.5 py-1.5 rounded-xl text-xs font-bold transition cursor-pointer bg-purple-600 text-white shadow-xs';
        currentCategory = this.getAttribute('data-category-filter') || '全部';
        filterArticles();
      });
    });

    if (searchInput) {
      searchInput.addEventListener('input', function(e) {
        currentQuery = (e.target.value || '').trim().toLowerCase();
        filterArticles();
      });
    }
  })();
</script>
