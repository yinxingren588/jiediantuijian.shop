---
export interface FAQItem {
  question: string;
  answer: string;
}

export interface Props {
  title?: string;
  subtitle?: string;
  items: FAQItem[];
}

const {
  title = "常见问题解答 (FAQ)",
  subtitle = "围绕节点推荐、机场节点选购与网络协议的真实核心解答",
  items,
} = Astro.props;

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map(item => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};
---

<section class="my-12">
  <div class="mb-8">
    <h2 class="text-2xl font-bold text-slate-900 tracking-tight">{title}</h2>
    {subtitle && <p class="text-sm text-slate-500 mt-1">{subtitle}</p>}
  </div>

  <div class="space-y-4">
    {items.map((item, index) => (
      <details class="group bg-white rounded-2xl border border-surface-border p-5 [&_summary::-webkit-details-marker]:hidden transition-all duration-200 hover:border-slate-300">
        <summary class="flex items-center justify-between cursor-pointer list-none font-bold text-slate-900 text-base select-none">
          <span class="flex items-center gap-3">
            <span class="w-6 h-6 rounded-full bg-brand-50 text-brand-600 flex items-center justify-center text-xs font-bold shrink-0">
              Q{index + 1}
            </span>
            <span>{item.question}</span>
          </span>
          <span class="text-slate-400 group-open:rotate-180 transition-transform duration-200">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </span>
        </summary>
        <div class="mt-4 pt-4 border-t border-slate-100 text-sm text-slate-600 leading-relaxed pl-9">
          {item.answer}
        </div>
      </details>
    ))}
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</section>
