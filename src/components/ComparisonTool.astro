---
import { airports } from '../data/airports';
import { calculatePerGBCost } from '../data/airports';

const initialAirports = airports.map(a => ({
  id: a.id,
  name: a.name,
  slug: a.slug,
  lineType: a.lineType,
  startingPrice: a.startingPrice,
  baseTrafficGB: a.plans[0]?.trafficGB || 0,
  perGb: calculatePerGBCost(a),
  regions: a.regions.join('、'),
  protocols: a.protocols.join('、'),
  deviceLimit: a.deviceLimit || '未核实',
  aiSupport: a.aiSupport?.join('、') || '基础支持',
  streamingSupport: a.streamingSupport?.join('、') || '基础支持',
  advantages: a.advantages.slice(0, 3),
  disadvantages: a.disadvantages.slice(0, 2),
  overallScore: a.overallScore,
  couponCode: a.couponCode || '',
  affiliateUrl: a.affiliateUrl,
}));
---

<div class="space-y-6" id="comparison-root">
  <!-- Controls Bar -->
  <div class="bg-white p-6 rounded-2xl border border-surface-border shadow-xs">
    <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
      <div>
        <h2 class="text-lg font-bold text-slate-900">选择待对比的机场品牌 (可选 2 ~ 4 家)</h2>
        <p class="text-xs text-slate-500 mt-1">勾选下方品牌，对比表格将实时刷新各维度核心参数与专属优惠券：</p>
      </div>
      <button
        id="reset-compare-btn"
        type="button"
        class="text-xs font-semibold px-3 py-1.5 rounded-lg bg-slate-100 text-slate-700 hover:bg-slate-200 transition"
      >
        重置选择
      </button>
    </div>

    <!-- Airport Checkboxes / Selector -->
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-3 mt-4 max-h-72 overflow-y-auto p-1" id="airport-selector-container">
      {initialAirports.map((item, index) => (
        <label class="flex items-center gap-2 p-2.5 rounded-xl border border-slate-200 hover:border-brand-300 hover:bg-brand-50/30 cursor-pointer transition select-none">
          <input
            type="checkbox"
            name="selected-airports"
            value={item.id}
            checked={index < 3}
            class="airport-checkbox rounded text-brand-600 focus:ring-brand-500 w-4 h-4 shrink-0"
          />
          <div class="min-w-0 flex-1">
            <div class="text-xs font-bold text-slate-900 truncate">{item.name}</div>
            <div class="flex items-center justify-between text-[10px] text-slate-500 font-mono mt-0.5">
              <span>¥{item.startingPrice}/月起</span>
              {item.couponCode && <span class="text-rose-600 font-bold">券</span>}
            </div>
          </div>
        </label>
      ))}
    </div>
  </div>

  <!-- Dynamic Comparison Table Container -->
  <div id="comparison-table-wrapper" class="bg-white rounded-2xl border border-surface-border shadow-xs overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-left text-sm border-collapse min-w-[720px]" id="comparison-table">
        <!-- Rendered via JavaScript -->
      </table>
    </div>
  </div>

  <!-- Empty state fallback -->
  <div id="compare-empty-state" class="hidden p-12 text-center bg-white rounded-2xl border border-surface-border">
    <p class="text-slate-500 text-sm">请至少勾选 2 家机场进行多维对比分析。</p>
  </div>
</div>

<script define:vars={{ initialAirports }}>
  const data = initialAirports;
  const checkboxes = document.querySelectorAll('.airport-checkbox');
  const table = document.getElementById('comparison-table');
  const emptyState = document.getElementById('compare-empty-state');
  const tableWrapper = document.getElementById('comparison-table-wrapper');
  const resetBtn = document.getElementById('reset-compare-btn');

  function getSelectedAirports() {
    const checkedIds = Array.from(checkboxes)
      .filter(cb => cb.checked)
      .map(cb => cb.value);
    return data.filter(item => checkedIds.includes(item.id));
  }

  function renderTable() {
    const selected = getSelectedAirports();

    if (selected.length < 1) {
      tableWrapper.classList.add('hidden');
      emptyState.classList.remove('hidden');
      return;
    }

    tableWrapper.classList.remove('hidden');
    emptyState.classList.add('hidden');

    let html = `
      <thead>
        <tr class="bg-slate-100/80 border-b border-slate-200 text-slate-900">
          <th class="py-3 px-4 w-36 font-bold text-xs uppercase tracking-wider text-slate-600 bg-slate-50">对比维度</th>
          ${selected.map(item => `
            <th class="py-4 px-4 text-center">
              <div class="font-extrabold text-base text-slate-900">${item.name}</div>
              <div class="text-xs text-brand-600 font-medium mt-0.5">${item.lineType}</div>
              <div class="mt-2 flex items-center justify-center gap-2">
                <a href="/review/${item.slug}/" class="text-[11px] px-2 py-0.5 rounded bg-brand-50 text-brand-700 hover:bg-brand-100 font-medium">深度评测</a>
                <a href="${item.affiliateUrl}" target="_blank" rel="noopener noreferrer nofollow" class="text-[11px] px-2 py-0.5 rounded bg-brand-600 text-white hover:bg-brand-700 font-medium">直达官网</a>
              </div>
            </th>
          `).join('')}
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100 text-xs sm:text-sm">
        <tr>
          <td class="py-3 px-4 font-semibold text-slate-700 bg-slate-50">专属优惠券</td>
          ${selected.map(item => `
            <td class="py-3 px-4 text-center">
              ${item.couponCode ? `
                <button
                  type="button"
                  data-copy-coupon="${item.couponCode}"
                  title="点击复制优惠码"
                  class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg bg-rose-50 hover:bg-rose-100 text-rose-700 font-mono font-bold border border-rose-200 text-xs transition cursor-pointer active:scale-95 group shadow-xs"
                >
                  <span>${item.couponCode}</span>
                  <span class="text-[10px] text-rose-500 opacity-80 group-hover:opacity-100 font-sans">📋复制</span>
                </button>
              ` : '<span class="text-slate-400 text-xs">暂无额外券</span>'}
            </td>
          `).join('')}
        </tr>
        <tr>
          <td class="py-3 px-4 font-semibold text-slate-700 bg-slate-50">综合评分</td>
          ${selected.map(item => `
            <td class="py-3 px-4 text-center font-mono font-bold text-amber-600 text-base">★ ${item.overallScore}</td>
          `).join('')}
        </tr>
        <tr>
          <td class="py-3 px-4 font-semibold text-slate-700 bg-slate-50">起步价格</td>
          ${selected.map(item => `
            <td class="py-3 px-4 text-center font-mono font-bold text-brand-600 text-base">¥${item.startingPrice} <span class="text-xs font-normal text-slate-500">/月起</span></td>
          `).join('')}
        </tr>
        <tr>
          <td class="py-3 px-4 font-semibold text-slate-700 bg-slate-50">起步月流量</td>
          ${selected.map(item => `
            <td class="py-3 px-4 text-center font-mono font-medium text-slate-800">${item.baseTrafficGB} GB /月</td>
          `).join('')}
        </tr>
        <tr>
          <td class="py-3 px-4 font-semibold text-slate-700 bg-slate-50">每GB折算成本</td>
          ${selected.map(item => `
            <td class="py-3 px-4 text-center font-mono font-semibold text-slate-900">¥${item.perGb} 元/GB</td>
          `).join('')}
        </tr>
        <tr>
          <td class="py-3 px-4 font-semibold text-slate-700 bg-slate-50">核心节点覆盖</td>
          ${selected.map(item => `
            <td class="py-3 px-4 text-center text-slate-600 text-xs">${item.regions}</td>
          `).join('')}
        </tr>
        <tr>
          <td class="py-3 px-4 font-semibold text-slate-700 bg-slate-50">支持协议</td>
          ${selected.map(item => `
            <td class="py-3 px-4 text-center font-mono text-xs text-slate-700">${item.protocols}</td>
          `).join('')}
        </tr>
        <tr>
          <td class="py-3 px-4 font-semibold text-slate-700 bg-slate-50">并发设备限制</td>
          ${selected.map(item => `
            <td class="py-3 px-4 text-center text-slate-700">${item.deviceLimit}</td>
          `).join('')}
        </tr>
        <tr>
          <td class="py-3 px-4 font-semibold text-slate-700 bg-slate-50">AI支持 (ChatGPT/Claude)</td>
          ${selected.map(item => `
            <td class="py-3 px-4 text-center text-xs text-emerald-700 font-medium bg-emerald-50/20">${item.aiSupport}</td>
          `).join('')}
        </tr>
        <tr>
          <td class="py-3 px-4 font-semibold text-slate-700 bg-slate-50">流媒体解锁 (Netflix/Disney)</td>
          ${selected.map(item => `
            <td class="py-3 px-4 text-center text-xs text-blue-700 font-medium bg-blue-50/20">${item.streamingSupport}</td>
          `).join('')}
        </tr>
        <tr>
          <td class="py-3 px-4 font-semibold text-slate-700 bg-slate-50">突出核心优点</td>
          ${selected.map(item => `
            <td class="py-3 px-4 text-xs text-slate-700">
              <ul class="list-disc list-inside space-y-1 text-left">
                ${item.advantages.map(adv => `<li>${adv}</li>`).join('')}
              </ul>
            </td>
          `).join('')}
        </tr>
        <tr>
          <td class="py-3 px-4 font-semibold text-slate-700 bg-slate-50">注意事项与不足</td>
          ${selected.map(item => `
            <td class="py-3 px-4 text-xs text-slate-600">
              <ul class="list-disc list-inside space-y-1 text-left">
                ${item.disadvantages.map(dis => `<li>${dis}</li>`).join('')}
              </ul>
            </td>
          `).join('')}
        </tr>
      </tbody>
    `;

    table.innerHTML = html;
  }

  checkboxes.forEach(cb => {
    cb.addEventListener('change', () => {
      const checked = Array.from(checkboxes).filter(c => c.checked);
      if (checked.length > 4) {
        alert('建议最多同时对比 4 家机场，以保证表格排版与参数阅读体验。');
        cb.checked = false;
        return;
      }
      renderTable();
    });
  });

  if (resetBtn) {
    resetBtn.addEventListener('click', () => {
      checkboxes.forEach((cb, index) => {
        cb.checked = index < 3;
      });
      renderTable();
    });
  }

  renderTable();
</script>
