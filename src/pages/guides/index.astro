---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allGuides = await getCollection('guides');
---

<BaseLayout
  title="客户端配置教程中心 - Windows/Android/iOS/macOS全平台指南"
  description="提供Windows电脑、Android安卓手机、iPhone/iPad苹果设备及Mac电脑的机场节点配置教程。涵盖Clash Verge Rev、Shadowrocket小火箭、Sing-box及v2rayNG设置。"
  breadcrumbs={[
    { name: '使用教程中心', url: '/guides/' },
  ]}
>
  <div class="py-6 space-y-8">
    <header class="border-b border-slate-200 pb-8">
      <div class="inline-block px-3 py-1 rounded-full bg-brand-50 border border-brand-200 text-brand-700 text-xs font-semibold mb-3">
        全平台实战手册
      </div>
      <h1 class="text-2xl sm:text-4xl font-extrabold text-slate-900 tracking-tight leading-tight">
        客户端配置使用教程中心
      </h1>
      <p class="text-sm sm:text-base text-slate-600 leading-relaxed mt-4 max-w-3xl">
        无论你是 Windows 电脑、Android 手机、iPhone / iPad 还是 Mac 用户，均可在这里找到最清晰图文并茂的客户端下载、订阅导入及分流避坑指南。
      </p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {allGuides.map(guide => {
        const slug = guide.id.replace(/\.(md|mdx)$/, '');
        return (
          <div class="bg-white p-6 rounded-2xl border border-surface-border shadow-xs hover:border-brand-400 hover:shadow-sm transition flex flex-col justify-between">
            <div>
              <div class="flex items-center gap-2 mb-2">
                <span class="px-2 py-0.5 rounded bg-brand-50 text-brand-700 font-bold text-xs uppercase">
                  {guide.data.platform}
                </span>
                <span class="text-xs text-slate-400">更新: {guide.data.updatedDate}</span>
              </div>
              <h2 class="text-lg font-bold text-slate-900 mb-2">
                <a href={`/guides/${slug}/`} class="hover:text-brand-600 transition">
                  {guide.data.title}
                </a>
              </h2>
              <p class="text-xs sm:text-sm text-slate-600 leading-relaxed line-clamp-3 mb-4">
                {guide.data.description}
              </p>
            </div>

            <div class="pt-4 border-t border-slate-100 flex items-center justify-between">
              <span class="text-xs text-slate-500">
                推荐：{guide.data.recommendedClients[0]}
              </span>
              <a
                href={`/guides/${slug}/`}
                class="text-xs font-semibold text-brand-600 hover:text-brand-700 flex items-center gap-1"
              >
                阅读完整图文 →
              </a>
            </div>
          </div>
        );
      })}
    </div>
  </div>
</BaseLayout>
