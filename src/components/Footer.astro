      <div class="flex items-center gap-6">
        <a href="/privacy-policy/" class="hover:underline">隐私条款</a>
        <a href="/disclaimer/" class="hover:underline">法律声明</a>
        <a href="/editorial-policy/" class="hover:underline">商业披露</a>
      </div>
    </div>
