---
import { getCollection, render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';

export async function getStaticPaths() {
  const rawPosts = await getCollection('blog');
  const rawGuides = await getCollection('guides');

  const posts = [...rawPosts].sort((a, b) => {
    const diff = new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime();
    return diff !== 0 ? diff : a.id.localeCompare(b.id);
  });

  const guides = [...rawGuides].sort((a, b) => {
    const diff = new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime();
    return diff !== 0 ? diff : a.id.localeCompare(b.id);
  });

  return posts.map((post, idx) => {
    const prevPost = posts[(idx - 1 + posts.length) % posts.length];
    const nextPost = posts[(idx + 1) % posts.length];
    const nextGuide = guides[idx % guides.length];
    const relatedPosts = [
      posts[(idx + 2) % posts.length],
      posts[(idx + 3) % posts.length],
    ];

    return {
      params: { slug: post.id.replace(/\.(md|mdx)$/, '') },
      props: {
        post,
        prevPost: {
          title: prevPost.data.title,
          url: `/blog/${prevPost.id.replace(/\.(md|mdx)$/, '')}/`,
          category: prevPost.data.category,
          description: prevPost.data.description,
        },
        nextPost: {
          title: nextPost.data.title,
          url: `/blog/${nextPost.id.replace(/\.(md|mdx)$/, '')}/`,
          category: nextPost.data.category,
          description: nextPost.data.description,
        },
        nextGuide: {
          title: nextGuide.data.title,
          url: `/guides/${nextGuide.id.replace(/\.(md|mdx)$/, '')}/`,
          platform: nextGuide.data.platform,
          description: nextGuide.data.description,
        },
        relatedPosts: relatedPosts.map(p => ({
          title: p.data.title,
          url: `/blog/${p.id.replace(/\.(md|mdx)$/, '')}/`,
          category: p.data.category,
          description: p.data.description,
        })),
      },
    };
  });
}

const { post, prevPost, nextPost, nextGuide, relatedPosts } = Astro.props;
const { Content } = await render(post);
---

<ArticleLayout
  title={post.data.title}
  description={post.data.description}
  publishDate={post.data.publishDate}
  updatedDate={post.data.updatedDate}
  author={post.data.author}
  category={post.data.category}
  tags={post.data.tags}
  type="blog"
  prevItem={prevPost}
  nextItem={nextPost}
  crossLink={nextGuide}
  relatedItems={relatedPosts}
  breadcrumbs={[
    { name: '机场推荐博客', url: '/blog/' },
    { name: post.data.title, url: `/blog/${post.id.replace(/\.(md|mdx)$/, '')}/` },
  ]}
>
  <Content />
</ArticleLayout>
