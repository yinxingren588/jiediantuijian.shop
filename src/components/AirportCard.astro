---
import type { Airport } from '../data/airports';
import { calculatePerGBCost } from '../data/airports';

export interface Props {
  airport: Airport;
  featured?: boolean;
}

const { airport, featured = false } = Astro.props;
const perGb = calculatePerGBCost(airport);
const basePlan = airport.plans[0];
---

<div class={`rounded-2xl border transition-all duration-200 bg-white p-6 flex flex-col justify-between ${
  featured ? 'border-brand-500 shadow-md ring-2 ring-brand-500/20' : 'border-surface-border shadow-xs hover:border-brand-300 hover:shadow-sm'
}`}>
  <div>
    <!-- Top Header -->
    <div class="flex items-start justify-between gap-4 mb-3">
      <div>
        <div class="flex items-center gap-2 flex-wrap">
          <h3 class="text-xl font-bold text-slate-900 tracking-tight">
            <a href={`/airport/${airport.slug}/`} class="hover:text-brand-600 transition">
              {airport.name}
            </a>
          </h3>
          <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-semibold bg-brand-50 text-brand-700 border border-brand-200">
            {airport.lineType}
          </span>
          {airport.testStatus === 'tested' && (
            <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-emerald-50 text-emerald-700 border border-emerald-200">
              ✓ 实测通过
            </span>
          )}
        </div>
        <p class="text-xs text-slate-500 mt-1 font-medium">{airport.tagline}</p>
      </div>

      <!-- Score Badge -->
      <div class="text-right shrink-0">
        <div class="inline-flex items-baseline px-2.5 py-1 rounded-xl bg-slate-900 text-white font-mono">
          <span class="text-xs font-medium mr-1 text-slate-400">评分</span>
          <span class="text-lg font-bold text-amber-400">{airport.overallScore}</span>
        </div>
      </div>
    </div>

    <!-- Pricing and specs box -->
    <div class="grid grid-cols-3 gap-2 my-4 p-3 rounded-xl bg-slate-50 border border-slate-100 text-center">
      <div>
        <span class="text-[11px] text-slate-500 block">起步价格</span>
        <span class="text-base font-extrabold text-brand-600 font-mono">
          ¥{airport.startingPrice}
        </span>
        <span class="text-[10px] text-slate-400 block">/月起</span>
      </div>
      <div>
        <span class="text-[11px] text-slate-500 block">入门流量</span>
        <span class="text-base font-bold text-slate-800 font-mono">
          {basePlan ? `${basePlan.trafficGB}G` : '未核实'}
        </span>
        <span class="text-[10px] text-slate-400 block">月度可用</span>
      </div>
      <div>
        <span class="text-[11px] text-slate-500 block">单GB均价</span>
        <span class="text-base font-bold text-slate-800 font-mono">
          ¥{perGb}
        </span>
        <span class="text-[10px] text-slate-400 block">元/GB</span>
      </div>
    </div>

    <!-- Description -->
    <p class="text-xs sm:text-sm text-slate-600 leading-relaxed mb-4 line-clamp-3">
      {airport.description}
    </p>

    <!-- Key Advantages (Bullet Points) -->
    <div class="mb-4 space-y-1.5">
      <span class="text-xs font-bold text-slate-800 block">核心优势：</span>
      {airport.advantages.slice(0, 3).map((adv) => (
        <div class="flex items-start gap-1.5 text-xs text-slate-700">
          <span class="text-emerald-500 font-bold shrink-0">✓</span>
          <span>{adv}</span>
        </div>
      ))}
    </div>

    <!-- Suitable For -->
    <div class="mb-4 pt-3 border-t border-slate-100">
      <span class="text-xs font-semibold text-slate-500 block mb-1.5">适合人群：</span>
      <div class="flex flex-wrap gap-1.5">
        {airport.suitableFor.map((item) => (
          <span class="px-2 py-0.5 rounded bg-slate-100 text-slate-600 text-[11px]">
            {item}
          </span>
        ))}
      </div>
    </div>
  </div>

  <!-- Bottom CTA buttons -->
  <div class="pt-4 border-t border-slate-100 flex items-center gap-2 mt-2">
    <a
      href={`/review/${airport.slug}/`}
      class="flex-1 text-center py-2 px-3 rounded-lg text-xs font-semibold bg-white border border-slate-300 text-slate-700 hover:bg-slate-50 hover:border-slate-400 transition"
    >
      深度评测与数据
    </a>
    <a
      href={`/airport/${airport.slug}/`}
      class="flex-1 text-center py-2 px-3 rounded-lg text-xs font-semibold bg-brand-600 text-white hover:bg-brand-700 transition shadow-xs"
    >
      套餐详情与入口
    </a>
  </div>
</div>
