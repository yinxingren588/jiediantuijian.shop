---
import BaseLayout from '../layouts/BaseLayout.astro';
import AirportCard from '../components/AirportCard.astro';
import RankingTable from '../components/RankingTable.astro';
import FAQSection from '../components/FAQSection.astro';
import { airports, getRankings } from '../data/airports';

const overallRankings = getRankings('overall');
const featuredAirports = airports.slice(0, 6);

const quickAnswers = [
  {
    title: "新手小白首选：月付试错与一键导入",
    content: "初次接触机场节点的用户，切忌直接购买昂贵的年付套餐。优先选择支持月付（9.9-20元）、提供直观客户端或一键导入订阅的服务商，验证在本地网络（如电信/联通/移动）下的实际表现后再做长期决定。",
  },
  {
    title: "核心考量维度：线路类型重于节点总数",
    content: "不要被宣传的‘几百个全球节点’所迷惑。决定晚高峰体验的是线路架构：全IEPL/IPLC内网专线由于不经过公网GFW，延迟极低且全天不丢包；而普通直连公网线路在晚间极易受QoS限速与拥堵影响。",
  },
  {
    title: "套餐性价比折算：防范倍率扣费陷阱",
    content: "计算每GB真实成本时，必须关注倍率规则。部分机场标称每月1000G，但高速专线节点倍率为3x甚至5x，实际可用流量缩水严重。本站排行榜均采用‘实际折算可用流量’计算真实单价。",
  },
  {
    title: "下单前必须自查：设备数与特定平台解锁",
    content: "检查是否支持自己的主力设备（Windows/Mac/iOS/Android），家庭或团队多设备需确认并发IP限制。如需使用ChatGPT或Netflix，需确认机场是否提供原生双ISP解锁节点以防封号。",
  },
];

const homeFAQs = [
  {
    question: "什么是优质的机场节点？如何辨别虚假宣传？",
    answer: "优质机场节点的核心指标是‘晚高峰低丢包率’与‘网络链路冗余度’，而非单纯看测速峰值。许多劣质服务商在闲时测速能跑满千兆，但在20:00-23:00晚高峰严重丢包、网页甚至无法打开。辨别时应关注其是否采用正规BGP入口及内网专线（IEPL/IPLC），并优先选择提供月付周期、售后工单响应及时的品牌。",
  },
  {
    question: "节点推荐中常说的‘内网专线（IEPL/IPLC）’和普通中转有什么区别？",
    answer: "普通中转节点的数据依然需要在公网长途传输，容易受到国际出口拥堵和运营商QoS限制；而IPLC/IEPL是点对点的跨境企业内网专线，数据在境内入口机房接收后，直接通过海底/陆地内网专用光缆传输到境外机房，不经过公网防火墙审查，具有极低网络抖动、零丢包及抗封锁的绝对优势。",
  },
  {
    question: "为什么访问ChatGPT或Claude时经常提示Access Denied？",
    answer: "OpenAI与Anthropic部署了极其严格的风控机制，会对公网IDC机房IP（如各大云服务器机房段）直接实施封锁或降智。想要顺畅使用AI工具，需要机场节点落地服务器采购本地住宅宽带或双ISP商业IP资源，并保持节点IP池的高纯净度。本站AI专用专题收录的节点均通过了持续的IP欺诈度检测。",
  },
  {
    question: "如果遇到机场节点连接不上，通常应该如何排查？",
    answer: "首先检查系统本地时间是否与北京时间精准同步（误差超过60秒会导致握手协议失败）；其次在客户端中更新订阅链接，确认套餐流量未耗尽或到期；第三测试切换不同入口的节点（如切换到备用香港或新加坡节点）；最后确认客户端内核是否开启了TUN虚拟网卡模式或系统代理开关。",
  },
];
---

<BaseLayout
  title="2026节点推荐与机场推荐指南 - 优质稳定高速机场节点评测排行"
  description="专注于中文网络环境的高速稳定节点推荐与机场节点选购指南。提供2026最新实测机场综合排行榜、性价比单价折算、全IEPL内网专线评测、多维对比工具及Windows/Android/iOS新手配置教程。"
>
  <!-- Hero Section -->
  <section class="py-10 md:py-16 text-center max-w-4xl mx-auto space-y-6">
    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-brand-50 border border-brand-200 text-brand-700 text-xs font-semibold">
      <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
      2026年度实测数据已同步更新 · 晚高峰连通性实测
    </div>

    <h1 class="text-3xl sm:text-5xl font-black text-slate-900 tracking-tight leading-tight">
      节点推荐与优质机场节点选购指南
    </h1>

    <p class="text-base sm:text-lg text-slate-600 leading-relaxed max-w-2xl mx-auto">
      拒绝浮夸营销与虚假测速。我们通过全天候晚高峰丢包监测、倍率流量折算及真实资费核验，为你提供客观严谨的<span class="text-slate-900 font-semibold">机场推荐</span>、<span class="text-slate-900 font-semibold">机场节点推荐</span>与综合排行榜。
    </p>

    <!-- Hero CTA Buttons -->
    <div class="flex flex-wrap items-center justify-center gap-3 pt-2">
      <a
        href="/ranking/overall/"
        class="px-6 py-3 rounded-xl bg-brand-600 hover:bg-brand-700 text-white font-semibold text-sm shadow-sm transition"
      >
        查看 2026 综合排行榜
      </a>
      <a
        href="/compare/"
        class="px-6 py-3 rounded-xl bg-white hover:bg-slate-50 text-slate-700 border border-slate-300 font-semibold text-sm transition"
      >
        机场在线参数比对
      </a>
      <a
        href="/recommend/stable/"
        class="px-6 py-3 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-800 font-semibold text-sm transition"
      >
        稳定专线机场精选
      </a>
    </div>

    <div class="pt-4 flex items-center justify-center gap-6 text-xs text-slate-500">
      <span>🔒 100% 拒绝虚假刷榜</span>
      <span>⚡ 真实晚高峰数据监测</span>
      <span>💰 透明流量倍率折算</span>
    </div>
  </section>

  <!-- Quick Answers (Section 3) -->
  <section class="my-12">
    <div class="bg-gradient-to-br from-violet-950 via-purple-900 to-slate-950 text-white rounded-3xl p-6 sm:p-10 shadow-xl border border-violet-800/40">
      <div class="max-w-2xl mb-8">
        <span class="text-xs font-semibold tracking-wider uppercase text-violet-300 block mb-2">快速答案 · 选购避坑总结</span>
        <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight">
          挑选机场节点前，先掌握这 4 个核心决策依据
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {quickAnswers.map((item, idx) => (
          <div class="bg-white/10 backdrop-blur-md rounded-2xl p-5 border border-white/10 hover:border-violet-400/30 transition">
            <div class="flex items-center gap-3 mb-2">
              <span class="w-6 h-6 rounded-lg bg-brand-500 text-white flex items-center justify-center font-bold text-xs">
                0{idx + 1}
              </span>
              <h3 class="font-bold text-base text-white">{item.title}</h3>
            </div>
            <p class="text-xs sm:text-sm text-purple-100 leading-relaxed pl-9">
              {item.content}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Featured Airports (Section 4) -->
  <section class="my-16">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-8">
      <div>
        <span class="text-xs font-semibold text-brand-600 uppercase tracking-wider block mb-1">年度精选推荐</span>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">
          精选主流机场节点评测与推荐
        </h2>
        <p class="text-sm text-slate-500 mt-1">经过严格周期性网络监测、资费核实且运营记录良好的服务商：</p>
      </div>
      <a href="/ranking/overall/" class="text-sm font-semibold text-brand-600 hover:underline flex items-center gap-1 shrink-0">
        查看完整排行榜
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {featuredAirports.map(airport => (
        <AirportCard airport={airport} featured={airport.overallScore >= 9.3} />
      ))}
    </div>
  </section>

  <!-- Comprehensive Rankings (Section 5) -->
  <section class="my-16">
    <div class="mb-6 flex flex-col sm:flex-row sm:items-end justify-between gap-4">
      <div>
        <span class="text-xs font-semibold text-brand-600 uppercase tracking-wider block mb-1">多维评分机制</span>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">
          2026 机场节点综合实力排行榜
        </h2>
        <p class="text-sm text-slate-500 mt-1">
          根据晚高峰网络稳定性(30%)、下行带宽(25%)、每GB实际价格(20%)、售后客服(15%)与流媒体AI解锁(10%)加权折算。
        </p>
      </div>
      <div class="flex items-center gap-2">
        <a href="/ranking/value/" class="text-xs px-3 py-1.5 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold transition">
          每GB单价榜
        </a>
        <a href="/ranking/stable/" class="text-xs px-3 py-1.5 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold transition">
          专线稳定榜
        </a>
      </div>
    </div>

    <RankingTable items={overallRankings} />
  </section>

  <!-- Categories: 按需求选择 (Section 6) -->
  <section class="my-16">
    <div class="mb-8 text-center max-w-2xl mx-auto">
      <span class="text-xs font-semibold text-brand-600 uppercase tracking-wider block mb-1">精准匹配场景</span>
      <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">
        按实际使用需求与预算选择
      </h2>
      <p class="text-sm text-slate-500 mt-1">每个人的网络使用场景不同，直达专属分类专题更高效：</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
      <a href="/recommend/stable/" class="p-6 rounded-2xl bg-white border border-surface-border hover:border-brand-400 hover:shadow-md transition group">
        <div class="w-12 h-12 rounded-xl bg-blue-50 text-brand-600 flex items-center justify-center font-bold text-xl mb-4 group-hover:bg-brand-600 group-hover:text-white transition">
          🛡️
        </div>
        <h3 class="font-bold text-lg text-slate-900 group-hover:text-brand-600 transition">稳定优先 · 内网专线</h3>
        <p class="text-xs text-slate-500 mt-2 leading-relaxed">
          全IEPL/IPLC独立专线架构，晚高峰零丢包，不经过公网审查，办公商务与省心用户首选。
        </p>
        <span class="inline-flex items-center gap-1 text-xs font-semibold text-brand-600 mt-4">
          查看专题清单 →
        </span>
      </a>

      <a href="/recommend/budget/" class="p-6 rounded-2xl bg-white border border-surface-border hover:border-brand-400 hover:shadow-md transition group">
        <div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center font-bold text-xl mb-4 group-hover:bg-emerald-600 group-hover:text-white transition">
          💰
        </div>
        <h3 class="font-bold text-lg text-slate-900 group-hover:text-emerald-600 transition">低预算 · 便宜高性价比</h3>
        <p class="text-xs text-slate-500 mt-2 leading-relaxed">
          月付10-20元亲民起步，百G月流量，支持低门槛月付体验，试错成本极低。
        </p>
        <span class="inline-flex items-center gap-1 text-xs font-semibold text-emerald-600 mt-4">
          查看平价清单 →
        </span>
      </a>

      <a href="/recommend/premium/" class="p-6 rounded-2xl bg-white border border-surface-border hover:border-brand-400 hover:shadow-md transition group">
        <div class="w-12 h-12 rounded-xl bg-purple-50 text-purple-600 flex items-center justify-center font-bold text-xl mb-4 group-hover:bg-purple-600 group-hover:text-white transition">
          🚀
        </div>
        <h3 class="font-bold text-lg text-slate-900 group-hover:text-purple-600 transition">高端旗舰 · 企业级大带宽</h3>
        <p class="text-xs text-slate-500 mt-2 leading-relaxed">
          华为云CC与高阶BGP入口，千兆端口独享冗余，支持团队多并发与外企跨境协作。
        </p>
        <span class="inline-flex items-center gap-1 text-xs font-semibold text-purple-600 mt-4">
          查看高端清单 →
        </span>
      </a>

      <a href="/recommend/ai/" class="p-6 rounded-2xl bg-white border border-surface-border hover:border-brand-400 hover:shadow-md transition group">
        <div class="w-12 h-12 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center font-bold text-xl mb-4 group-hover:bg-amber-600 group-hover:text-white transition">
          🤖
        </div>
        <h3 class="font-bold text-lg text-slate-900 group-hover:text-amber-600 transition">ChatGPT & AI 工具专用</h3>
        <p class="text-xs text-slate-500 mt-2 leading-relaxed">
          纯净双ISP住宅IP落地，深度解决OpenAI、Claude访问受限、403阻断与降智问题。
        </p>
        <span class="inline-flex items-center gap-1 text-xs font-semibold text-amber-600 mt-4">
          查看AI专题 →
        </span>
      </a>

      <a href="/recommend/streaming/" class="p-6 rounded-2xl bg-white border border-surface-border hover:border-brand-400 hover:shadow-md transition group">
        <div class="w-12 h-12 rounded-xl bg-rose-50 text-rose-600 flex items-center justify-center font-bold text-xl mb-4 group-hover:bg-rose-600 group-hover:text-white transition">
          🎬
        </div>
        <h3 class="font-bold text-lg text-slate-900 group-hover:text-rose-600 transition">4K 流媒体全解锁</h3>
        <p class="text-xs text-slate-500 mt-2 leading-relaxed">
          原生解锁Netflix全部非自制剧、Disney+、YouTube Premium及HBO Max，超高清极速播放。
        </p>
        <span class="inline-flex items-center gap-1 text-xs font-semibold text-rose-600 mt-4">
          查看流媒体清单 →
        </span>
      </a>

      <a href="/recommend/beginner/" class="p-6 rounded-2xl bg-white border border-surface-border hover:border-brand-400 hover:shadow-md transition group">
        <div class="w-12 h-12 rounded-xl bg-cyan-50 text-cyan-600 flex items-center justify-center font-bold text-xl mb-4 group-hover:bg-cyan-600 group-hover:text-white transition">
          🔰
        </div>
        <h3 class="font-bold text-lg text-slate-900 group-hover:text-cyan-600 transition">新手入门 · 一键导入</h3>
        <p class="text-xs text-slate-500 mt-2 leading-relaxed">
          支持一键导入主流客户端，提供全平台详细新手配置教程，不用折腾复杂技术参数。
        </p>
        <span class="inline-flex items-center gap-1 text-xs font-semibold text-cyan-600 mt-4">
          查看新手指南 →
        </span>
      </a>
    </div>
  </section>

  <!-- Comparison Banner (Section 7) -->
  <section class="my-16 bg-gradient-to-r from-violet-100/90 via-purple-100/70 to-indigo-100/80 rounded-3xl p-8 sm:p-10 border border-violet-200 shadow-xs">
    <div class="flex flex-col md:flex-row items-center justify-between gap-6">
      <div class="space-y-2 max-w-xl">
        <span class="px-2.5 py-1 rounded bg-brand-100 text-brand-800 text-xs font-bold">在线工具</span>
        <h2 class="text-2xl font-bold text-slate-900">拿不准选哪个？使用机场节点多维对比工具</h2>
        <p class="text-sm text-slate-600">
          自由选择 2 ~ 4 家机场品牌，针对价格、每GB单价、支持协议、AI解锁、设备限制及优缺点进行横向参数比对。
        </p>
      </div>
      <a
        href="/compare/"
        class="shrink-0 px-6 py-3.5 rounded-xl bg-brand-600 hover:bg-brand-700 text-white font-bold text-sm shadow-sm transition"
      >
        立即进入横向对比工具 →
      </a>
    </div>
  </section>

  <!-- Section 8: 最新独立深度评测 (29款品牌评测入口) -->
  <section class="my-16">
    <div class="mb-8 flex flex-col sm:flex-row sm:items-end justify-between gap-4">
      <div>
        <span class="text-xs font-semibold text-purple-700 uppercase tracking-wider block mb-1">权威技术横评</span>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">
          最新主流机场独立深度技术评测报告
        </h2>
        <p class="text-sm text-slate-500 mt-1">
          本站对全网 29 款服务商建立独立评测档案，涵盖底层专线拓扑、晚高峰丢包跑分与双 ISP 解锁矩阵：
        </p>
      </div>
      <a href="/review/" class="text-sm font-bold text-purple-700 hover:underline flex items-center gap-1 shrink-0">
        查看全部 29 款品牌深度评测
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {airports.slice(0, 3).map(airport => (
        <div class="bg-white rounded-3xl p-6 border border-purple-200/80 shadow-xs hover:border-purple-400 hover:shadow-md transition flex flex-col justify-between space-y-4">
          <div>
            <div class="flex items-center justify-between pb-3 border-b border-slate-100">
              <h3 class="text-lg font-bold text-slate-900">
                <a href={`/review/${airport.slug}/`} class="hover:text-purple-700 transition">
                  {airport.name}
                </a>
              </h3>
              <span class="px-2 py-0.5 rounded text-xs font-semibold bg-purple-50 text-purple-700 border border-purple-200">
                {airport.lineType}
              </span>
            </div>
            <p class="text-xs text-slate-600 mt-3 line-clamp-2 leading-relaxed">
              {airport.tagline}
            </p>
            <div class="mt-3 flex items-center justify-between text-xs font-mono">
              <span class="text-purple-700 font-bold">起步 ¥{airport.startingPrice}/月</span>
              <span class="text-slate-500">实测评分 ★ {airport.overallScore}</span>
            </div>
          </div>
          <div class="pt-3 border-t border-slate-100 flex items-center gap-2">
            <a
              href={`/review/${airport.slug}/`}
              class="flex-1 text-center py-2 px-3 rounded-xl text-xs font-bold bg-purple-50 hover:bg-purple-100 text-purple-800 border border-purple-200 transition"
            >
              阅读详细评测 →
            </a>
            <a
              href={airport.affiliateUrl}
              target="_blank"
              rel="noopener noreferrer nofollow"
              class="text-center py-2 px-3 rounded-xl text-xs font-semibold bg-slate-900 hover:bg-slate-800 text-white transition"
            >
              官网直达
            </a>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Guides Center (Section 9) -->
  <section class="my-16">
    <div class="mb-8 flex flex-col sm:flex-row sm:items-end justify-between gap-4">
      <div>
        <span class="text-xs font-semibold text-purple-700 uppercase tracking-wider block mb-1">使用教程中心 · 34 篇全平台手册</span>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">各平台客户端配置与高阶进阶实操</h2>
        <p class="text-sm text-slate-500 mt-1">涵盖主流桌面与移动操作系统、路由器透明网关、4K电视大屏及 ChatGPT 专项避坑教程：</p>
